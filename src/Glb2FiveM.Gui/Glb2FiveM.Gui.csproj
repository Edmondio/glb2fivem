<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../build/Publish.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>glb2fivem-gui</AssemblyName>
    <RootNamespace>Glb2FiveM.Gui</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>../../build/glb2fivem.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Glb2FiveM.Core/Glb2FiveM.Core.csproj" />
  </ItemGroup>
  <!-- L'interface web est embarquée dans l'exe (prêt pour un publish en fichier unique). -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot/**/*" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Éditeur d'image miniPaint (MIT), version figée récupérée par tools/setup-deps. -->
  <ItemGroup Condition="Exists('../../third_party/miniPaint/dist/bundle.js')">
    <EmbeddedResource Include="../../third_party/miniPaint/index.html" LogicalName="wwwroot/vendor/minipaint/index.html" />
    <EmbeddedResource Include="../../third_party/miniPaint/dist/bundle.js" LogicalName="wwwroot/vendor/minipaint/dist/bundle.js" />
    <EmbeddedResource Include="../../third_party/miniPaint/images/**/*" Exclude="../../third_party/miniPaint/images/preview.*;../../third_party/miniPaint/images/test-collection.json" LogicalName="wwwroot/vendor/minipaint/images/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
