<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Aucune source par défaut : le projet compile ses dépendances depuis les sources (third_party/), hors ligne.
       build-exe.bat ajoute nuget.org uniquement pour télécharger le runtime .NET Windows du .exe autonome. -->
  <packageSources><clear /></packageSources>
</configuration>
